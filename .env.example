# Endpoint opcional para o formulário de contato (recebe POST JSON).
# Ex.: Formspree (https://formspree.io/f/SEU_ID), uma função serverless ou um webhook de CRM.
# Sem essa variável, o formulário abre o WhatsApp com a mensagem já preenchida.
NEXT_PUBLIC_FORM_ENDPOINT=

# Gera versão 100% estática em /out quando igual a 1 (não é necessário na Vercel).
STATIC_EXPORT=
